# File conflict between two packages: last package in YAML order wins.
# Both pkg-a and pkg-b have shared.txt — pkg-b is declared last, so its
# version must be present in the build output.
#
# Layout:
#   $WORK/src/pkg-a/  — package source
#   $WORK/src/pkg-b/  — package source
#   $WORK/platform/   — domain, compose runs here

exec sh -c 'cd platform && launchr compose --interactive=false'
stdout 'Creating composition'
! stderr .

# pkg-b is declared after pkg-a → its shared.txt wins
grep 'from pkg-b' platform/.compose/build/shared.txt

-- platform/plasma-compose.yaml --
dependencies:
  - name: pkg-a
    source:
      type: path
      url: ../src/pkg-a
  - name: pkg-b
    source:
      type: path
      url: ../src/pkg-b

-- src/pkg-a/shared.txt --
from pkg-a

-- src/pkg-b/shared.txt --
from pkg-b
